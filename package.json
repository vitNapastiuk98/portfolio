{
  "name": "portfolio",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run content:generate && ng serve",
    "build": "npm run content:generate && ng build",
    "content:generate": "node scripts/generate-content.mjs",
    "content:check": "node scripts/generate-content.mjs --check",
    "lint": "eslint . && npm run content:check",
    "format:check": "prettier --check .",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false && node --test scripts/*.test.mjs",
    "test:watch": "ng test",
    "verify:dist": "node scripts/verify-build.mjs",
    "deploy": "npm run build && npm run verify:dist && firebase deploy --only hosting"
  },
  "private": true,
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@angular/common": "^22.2.2",
    "@angular/compiler": "^22.2.2",
    "@angular/core": "^22.2.2",
    "@angular/forms": "^22.2.2",
    "@angular/platform-browser": "^22.2.2",
    "@angular/platform-server": "^22.2.2",
    "@angular/router": "^22.2.2",
    "@angular/ssr": "^22.2.2",
    "@fontsource-variable/manrope": "^5.2.8",
    "@fontsource-variable/syne": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "gray-matter": "^4.0.3",
    "gsap": "^3.15.0",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.0",
    "sanitize-html": "^2.17.0",
    "three": "^0.186.0",
    "zod": "^4.1.12",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.2",
    "@angular-eslint/eslint-plugin": "^22.2.0",
    "@angular-eslint/eslint-plugin-template": "^22.2.0",
    "@angular-eslint/template-parser": "^22.2.0",
    "@types/sanitize-html": "^2.16.0",
    "@types/three": "^0.186.0",
    "eslint": "^9.39.1",
    "firebase-tools": "^15.1.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.46.2",
    "vitest": "^4.0.8"
  }
}
